{
  "name": "atlas",
  "version": "0.1.0",
  "description": "Atlas V0.1 — headless AI software engineering orchestration engine (foundation)",
  "type": "module",
  "private": true,
  "bin": {
    "atlas": "./dist/cli/run.js"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "atlas": "node ./dist/cli/run.js",
    "doctor": "node ./dist/cli/run.js doctor",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev"
  },
  "dependencies": {
    "@prisma/client": "^6.0.0",
    "commander": "^14.0.0",
    "dotenv": "^16.4.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "prisma": "^6.0.0",
    "typescript": "^5.5.0",
    "vitest": "^3.0.0"
  },
  "engines": {
    "node": ">=20"
  }
}
